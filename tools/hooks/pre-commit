#!/bin/sh
# Bump the app version whenever the app's own files are part of the commit, so
# the version on your phone always tells you which build you are looking at.
#
# Enabled with:  git config core.hooksPath tools/hooks
set -e

changed=$(git diff --cached --name-only)
case "$changed" in
  *index.html*|*sw.js*|*manifest.json*) ;;
  *) exit 0 ;;
esac

# A bump commit made by this hook must not bump itself again.
if [ -n "$SKIP_VERSION_BUMP" ]; then exit 0; fi

node tools/bump.js
git add index.html sw.js
